# MySQL connection. URL-encode special characters in the username/password.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/darisav"

# Public HTTPS origin of this Next.js app (no trailing slash).
APP_BASE_URL="https://example.com"
APP_SESSION_SECRET="replace-with-at-least-32-random-bytes"
# 32-byte key encoded as 64 hexadecimal characters; encrypts Telegram invite URLs.
APP_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Telegram Login OIDC values from BotFather.
TELEGRAM_LOGIN_CLIENT_ID=""
TELEGRAM_LOGIN_CLIENT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_CHANNEL_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# WebPay sandbox. Keep WEBPAY_TEST=1 while testing.
WEBPAY_STORE_ID=""
WEBPAY_STORE_NAME=""
WEBPAY_SECRET_KEY=""
WEBPAY_TEST="1"
# Set these to the merchant order currency and amount agreed/configured with WebPay.
WEBPAY_CURRENCY_ID=""
BLONDE_FORMULA_AMOUNT=""
# Optional fallback reconciliation credentials for billing get_transaction API.
WEBPAY_API_USERNAME=""
WEBPAY_API_PASSWORD=""
# Set to true only if WebPay includes card in the notification signature for this merchant.
WEBPAY_NOTIFY_SIGNATURE_INCLUDES_CARD="false"

# Protects manual refund/chargeback status operations.
ADMIN_API_SECRET=""
